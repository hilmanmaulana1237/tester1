# Copy this file to your server, then set DEPLOY_ENV_FILE to this path.
# Example:
#   sudo mkdir -p /etc/baru
#   sudo cp deploy.env.example /etc/baru/deploy.env
#   sudo nano /etc/baru/deploy.env
#   DEPLOY_ENV_FILE=/etc/baru/deploy.env bash deploy.sh

REPO_URL=https://github.com/hilmanmaulana1237/baru.git
BRANCH=main
APP_DIR=/var/www/baru

WEB_USER=www-data
WEB_GROUP=www-data

PHP_BIN=php
COMPOSER_BIN=composer
NPM_BIN=npm

RUN_MIGRATIONS=1
RUN_NPM_BUILD=1
RUN_STORAGE_LINK=1
RUN_QUEUE_RESTART=1

PHP_FPM_SERVICE=php8.3-fpm
WEB_SERVER_SERVICE=nginx

# Optional: set your app health endpoint URL.
# HEALTHCHECK_URL=https://your-domain.com/up
